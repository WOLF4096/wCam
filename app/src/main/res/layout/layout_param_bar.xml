<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:paddingVertical="12dp"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <LinearLayout
        android:id="@+id/layout_param_ev"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EV" android:textColor="#80FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/tv_val_ev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_param_wb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WB" android:textColor="#80FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/tv_val_wb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5200K" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_param_iso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ISO" android:textColor="#80FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/tv_val_iso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_param_s"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S" android:textColor="#80FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/tv_val_s" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1/60" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_param_af"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AF" android:textColor="#80FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/tv_val_af" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.5" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>
