<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <!-- 100px Safety Zone -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100px" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt; 更多设置"
            android:textColor="@color/settings_text_main"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- 1. Format Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存格式"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/chip_raw"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="RAW"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="4dp"
                        android:clickable="true" />
                    <TextView
                        android:id="@+id/chip_jpg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="JPG"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true" />
                    <TextView
                        android:id="@+id/chip_heif"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="HEIF"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_jpg_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JPG质量"
                        android:textColor="@color/settings_text_main"
                        android:textSize="13sp"
                        android:minWidth="60dp" />
                    <SeekBar
                        android:id="@+id/seekbar_quality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="90" />
                    <TextView
                        android:id="@+id/tv_quality_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90%"
                        android:textColor="@color/settings_primary"
                        android:textSize="14sp"
                        android:minWidth="40dp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="保存地理位置"
                        android:textColor="@color/settings_text_main"
                        android:textSize="13sp" />
                    <Switch
                        android:id="@+id/switch_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/white"
                        android:trackTint="@drawable/sl_switch_track" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Algorithm Card -->
            <LinearLayout
                android:id="@+id/card_algo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="处理方式"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/seg_simple"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="简单处理"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="4dp"
                        android:clickable="true" />
                    <TextView
                        android:id="@+id/seg_demosaic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="去马赛克"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/grid_algo_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:rowCount="1"
                    android:alignmentMode="alignBounds"
                    android:columnOrderPreserved="false">
                </GridLayout>

                <GridLayout
                    android:id="@+id/grid_algo_demosaic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:rowCount="2"
                    android:alignmentMode="alignBounds"
                    android:columnOrderPreserved="false"
                    android:visibility="gone">
                </GridLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/settings_unselected_bg"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="直方图"
                        android:textColor="@color/settings_text_main"
                        android:textSize="13sp" />
                    <Switch
                        android:id="@+id/switch_histogram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/white"
                        android:trackTint="@drawable/sl_switch_track" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Watermark Card -->
            <LinearLayout
                android:id="@+id/card_watermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="水印"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/seg_wm_none"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="无"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/seg_wm_internal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="内部"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="4dp" />
                    <TextView
                        android:id="@+id/seg_wm_external"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="外部"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panel_wm_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:id="@+id/chip_wm_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/sl_settings_chip"
                            android:text="时间"
                            android:textColor="@color/sl_settings_chip_text"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/chip_wm_params"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/sl_settings_chip"
                            android:text="参数"
                            android:textColor="@color/sl_settings_chip_text"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:layout_marginHorizontal="4dp" />
                        <TextView
                            android:id="@+id/chip_wm_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/sl_settings_chip"
                            android:text="固定文本"
                            android:textColor="@color/sl_settings_chip_text"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/et_wm_custom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/settings_unselected_bg"
                        android:hint="输入水印文本..."
                        android:padding="10dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/settings_text_main"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
