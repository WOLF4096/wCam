<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <!-- 100px Safety Zone -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100px" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt; 更多设置"
            android:textColor="@color/settings_text_main"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- 1. Format Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存格式"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/chip_raw"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="RAW"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="4dp"
                        android:clickable="true" />
                    <TextView
                        android:id="@+id/chip_jpg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="JPG"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true" />
                    <TextView
                        android:id="@+id/chip_png"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="PNG"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_jpg_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JPG质量"
                        android:textColor="@color/settings_text_main"
                        android:textSize="13sp"
                        android:minWidth="60dp" />
                    <SeekBar
                        android:id="@+id/seekbar_quality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="90" />
                    <TextView
                        android:id="@+id/tv_quality_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90%"
                        android:textColor="@color/settings_primary"
                        android:textSize="14sp"
                        android:minWidth="40dp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="保存地理位置"
                        android:textColor="@color/settings_text_main"
                        android:textSize="13sp" />
                    <Switch
                        android:id="@+id/switch_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/white"
                        android:trackTint="@drawable/sl_switch_track" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Algorithm Card -->
            <LinearLayout
                android:id="@+id/card_algo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="处理方式"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/seg_simple"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="简单处理"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="4dp"
                        android:clickable="true" />
                    <TextView
                        android:id="@+id/seg_demosaic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="去马赛克"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginStart="4dp"
                        android:clickable="true" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/grid_algo_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:rowCount="1"
                    android:alignmentMode="alignBounds"
                    android:columnOrderPreserved="false">
                </GridLayout>

                <GridLayout
                    android:id="@+id/grid_algo_demosaic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:rowCount="2"
                    android:alignmentMode="alignBounds"
                    android:columnOrderPreserved="false"
                    android:visibility="gone">
                </GridLayout>
            </LinearLayout>

            <!-- 3. Countdown Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="倒计时"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">
                    <SeekBar
                        android:id="@+id/seekbar_countdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:paddingVertical="12dp"
                        android:splitTrack="false" />
                    <TextView
                        android:id="@+id/tv_countdown_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0s"
                        android:textColor="@color/settings_primary"
                        android:textSize="14sp"
                        android:minWidth="45dp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Auto Capture Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动拍摄"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/seg_auto_none"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="无"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/seg_auto_interval"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="间隔"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="4dp" />
                    <TextView
                        android:id="@+id/seg_auto_continuous"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="连续"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- New Single Line Interval Panel -->
                <LinearLayout
                    android:id="@+id/panel_auto_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/settings_unselected_bg"
                    android:padding="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="间隔" android:textColor="@color/white" />
                    <EditText
                        android:id="@+id/et_interval_sec"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="number"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="@color/settings_primary"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="s拍一张，持续" android:textColor="@color/white" />
                    <EditText
                        android:id="@+id/et_interval_duration"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="number"
                        android:gravity="center"
                        android:text="60"
                        android:textColor="@color/settings_primary"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="s" android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panel_auto_continuous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@color/settings_unselected_bg"
                    android:padding="8dp"
                    android:gravity="center"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="连续拍" android:textColor="@color/white" />
                    <EditText
                        android:id="@+id/et_continuous_count"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="number"
                        android:gravity="center"
                        android:text="10"
                        android:textColor="@color/settings_primary"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="张" android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Watermark Card -->
            <LinearLayout
                android:id="@+id/card_watermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="水印"
                    android:textColor="@color/settings_text_main"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/seg_wm_none"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="无"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="4dp" />
                    <TextView
                        android:id="@+id/seg_wm_internal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="内部"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginHorizontal="4dp" />
                    <TextView
                        android:id="@+id/seg_wm_external"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/sl_settings_chip"
                        android:text="外部"
                        android:textColor="@color/sl_settings_chip_text"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panel_wm_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:id="@+id/chip_wm_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/sl_settings_chip"
                            android:text="时间"
                            android:textColor="@color/sl_settings_chip_text"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/chip_wm_params"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/sl_settings_chip"
                            android:text="参数"
                            android:textColor="@color/sl_settings_chip_text"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:layout_marginHorizontal="4dp" />
                        <TextView
                            android:id="@+id/chip_wm_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/sl_settings_chip"
                            android:text="固定文本"
                            android:textColor="@color/sl_settings_chip_text"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                    <EditText
                        android:id="@+id/et_wm_custom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/settings_unselected_bg"
                        android:hint="输入水印文本..."
                        android:padding="10dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/settings_text_main"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
