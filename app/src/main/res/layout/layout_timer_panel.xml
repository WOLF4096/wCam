<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="倒计时"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <SeekBar
            android:id="@+id/seekbar_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:splitTrack="false" />
        <TextView
            android:id="@+id/tv_countdown_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0s"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:minWidth="45dp"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自动拍摄"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <TextView
            android:id="@+id/seg_auto_none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/sl_settings_chip"
            android:text="无"
            android:textColor="@color/sl_settings_chip_text"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:layout_marginEnd="4dp"
            android:clickable="true" />
        <TextView
            android:id="@+id/seg_auto_interval"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/sl_settings_chip"
            android:text="间隔"
            android:textColor="@color/sl_settings_chip_text"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="4dp"
            android:clickable="true" />
        <TextView
            android:id="@+id/seg_auto_continuous"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/sl_settings_chip"
            android:text="连续"
            android:textColor="@color/sl_settings_chip_text"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:layout_marginStart="4dp"
            android:clickable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_auto_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#33000000"
        android:padding="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="间隔" android:textColor="#FFFFFF" android:textSize="12sp" />
        <EditText
            android:id="@+id/et_interval_sec"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:inputType="number"
            android:gravity="center"
            android:text="5"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="s拍一张，持续" android:textColor="#FFFFFF" android:textSize="12sp" />
        <EditText
            android:id="@+id/et_interval_duration"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:inputType="number"
            android:gravity="center"
            android:text="60"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="s" android:textColor="#FFFFFF" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_auto_continuous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#33000000"
        android:padding="8dp"
        android:gravity="center"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="连续拍" android:textColor="#FFFFFF" android:textSize="12sp" />
        <EditText
            android:id="@+id/et_continuous_count"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:inputType="number"
            android:gravity="center"
            android:text="10"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="张" android:textColor="#FFFFFF" android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
