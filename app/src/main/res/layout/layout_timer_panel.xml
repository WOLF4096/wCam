<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Card 1: Countdown -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_timer_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒计时"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/seekbar_countdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:splitTrack="false"
                android:thumb="@drawable/ic_timer_thumb"
                android:progressTint="#FFCC00"
                android:progressBackgroundTint="#33FFFFFF" />
            <TextView
                android:id="@+id/tv_countdown_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0s"
                android:textColor="#FFCC00"
                android:textSize="14sp"
                android:minWidth="40dp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card 2: Auto Capture -->
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_timer_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动拍摄"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/seg_auto_none"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/sl_settings_chip"
                android:text="无"
                android:textColor="@color/sl_settings_chip_text"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/seg_auto_interval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/sl_settings_chip"
                android:text="间隔"
                android:textColor="@color/sl_settings_chip_text"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:layout_marginHorizontal="3dp"
                android:clickable="true"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/seg_auto_continuous"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/sl_settings_chip"
                android:text="连续"
                android:textColor="@color/sl_settings_chip_text"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Panel: Interval -->
        <LinearLayout
            android:id="@+id/panel_auto_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_timer_panel_item"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="间隔拍" android:textColor="#FFFFFF" android:textSize="14sp" />
            <EditText
                android:id="@+id/et_interval_sec"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="number"
                android:gravity="center"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="s / 持续" android:textColor="#FFFFFF" android:textSize="14sp" />
            <EditText
                android:id="@+id/et_interval_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="number"
                android:gravity="center"
                android:text="60"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="s" android:textColor="#FFFFFF" android:textSize="14sp" />
        </LinearLayout>

        <!-- Dynamic Panel: Continuous -->
        <LinearLayout
            android:id="@+id/panel_auto_continuous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_timer_panel_item"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="连续拍"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/et_continuous_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="number"
                android:gravity="center"
                android:text="10"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="张"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
