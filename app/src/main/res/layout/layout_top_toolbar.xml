<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_toolbar"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingHorizontal="16dp">

    <TextView android:id="@+id/btn_flash" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/toolbar_flash" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" />
    <TextView android:id="@+id/btn_histogram" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/toolbar_histogram" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" />
    <TextView android:id="@+id/btn_grid_lines" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/toolbar_grid_lines" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" />
    <TextView android:id="@+id/btn_resolution" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/toolbar_resolution" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" />
    <TextView android:id="@+id/btn_format" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/toolbar_format" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" />
</LinearLayout>
